# Caminho local encaminhado à API Java publicada. Funciona em dev e na Vercel.
VITE_API_URL=/api
API_PROXY_TARGET=https://soulpass-api.onrender.com
# Chatbot configurado com o snippet enviado pela equipe. Use false para desativar.
VITE_WATSON_ENABLED=true

# IDs públicos da aba Integrations > Web chat > Embed (não são API keys).
# Região mantida exatamente como no snippet enviado, incluindo a URL completa.
VITE_WATSON_INTEGRATION_ID=e3b7d962-7de4-4105-9fcc-2645dd6f580d
VITE_WATSON_REGION=https://integrations.us-south.assistant.watson.appdomain.cloud
VITE_WATSON_SERVICE_INSTANCE_ID=17b1816c-9ace-4e29-9af9-9b91c042aacf
